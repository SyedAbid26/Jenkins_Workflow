pipeline {
    agent any
    tools {
        maven 'Maven'
    }
    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Clone Repository') {
            steps {
                git branch: 'main',
                    url: ''
            }
        }
        stage('Verify Tools') {
            steps {
                sh 'mvn -version'
            }
        }
        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Artifact uploader') {
            steps {
                nexusArtifactUploader artifacts: [[artifactId: 'From Pom.xml File', classifier: '', file: 'target/test.war', type: 'war']],
                    credentialsId: 'Nexus',
                    groupId: 'From Pom.xml File',
                    nexusUrl: 'PublicIP:8081',
                    nexusVersion: 'nexus3',
                    protocol: 'http',
                    repository: 'Nexus Repo Name',
                    version: '1.0-SNAPSHOT'
            }
        }
        stage('Build Docker Image') {
            steps {
                sh '''
                docker build -t ImageName:latest .
                docker tag test-p1:latest UserName/ImageName:latest
                docker images
                '''
            }
        }
        stage('Push Docker Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'Docker',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                    echo "DEBUG: username length is ${#DOCKER_USER}"
                    echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                    docker push UserName/ImageName:latest
                    docker logout
                    '''
                }
            }
        }
        stage('Deploy') {
            steps {
                sh '''
                docker pull UserName/ImageName:latest
                docker stop ImageName || true
                docker rm ImageName || true
                docker run -d \
                --name ImageName \
                -p 8083:8080 \
                UserName/ImageName:latest
                '''
            }
        }
    }
}
